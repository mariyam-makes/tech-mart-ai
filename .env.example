PORT=3000

# Required for AI chat responses using Gemini
GOOGLE_API_KEY=your_google_api_key_here

# Required for refund confirmation emails
GMAIL_EMAIL=your_email_here
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Optional: used by AI logging if you configure Google Sheets webhook logging
GOOGLE_SHEETS_WEBHOOK_URL=https://example.com/google-sheets-webhook
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Not currently used by this codebase:
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# DATABASE_URL=
# MONGODB_URI=
# SUPABASE_URL=
